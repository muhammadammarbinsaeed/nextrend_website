# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Restart `npm run dev` after changing it.

# --- Gmail SMTP (App Password) ---
# 1) Turn on 2-Step Verification for the Gmail account
# 2) Google Account > Security > App passwords > create one for "Mail"
# 3) Paste the 16-character password below (spaces are fine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true for port 465 (SSL), false for 587 (STARTTLS). Optional: defaults to true when port is 465.
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=

# Where enquiries are delivered (defaults to SMTP_USER)
CONTACT_TO_EMAIL=hello@nextrend.tech
# Optional "from" header (Gmail will rewrite it to SMTP_USER unless it is a verified alias)
CONTACT_FROM_EMAIL=Nextrend Website <yourname@gmail.com>
